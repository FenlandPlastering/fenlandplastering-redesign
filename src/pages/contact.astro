---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

---

<Base title="Contact Us | Fenland Plastering Services" description="Contact Fenland Plastering Services to discuss your plastering project or request a quotation.">
  <Header />
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="eyebrow">Let's talk</span>
        <h1>Contact Us</h1>
        <p>Tell us a little about your project and what you need.</p>
      </div>
    </section>

    <section class="section-padding">
      <div class="contact-grid">
        <div class="contact-copy">
          <span class="section-kicker">Get in touch</span>
          <h2>Let's discuss your project.</h2>
          <p>Whether you're planning improvements to your home, arranging work on a commercial property or considering a larger project, we'd like to hear from you.</p>
          <p>Use the details you have been given by Fenland Plastering Services to get in touch and discuss your requirements.</p>

          <div class="contact-detail">
            <span class="contact-detail-label">Business</span>
            <strong>Fenland Plastering Services</strong>
          </div>
          <div class="contact-detail">
            <span class="contact-detail-label">Service type</span>
            <strong>Domestic & Commercial Plastering</strong>
          </div>
        </div>

        <div class="contact-panel">
          <span class="section-kicker">Request a quotation</span>
          <h2>Tell us about the work.</h2>
          <p>When making an enquiry, it helps to include:</p>
          <ul>
            <li>Your name and preferred contact details</li>
            <li>The town or area where the work is needed</li>
            <li>A description of the plastering required</li>
            <li>Whether the project is domestic or commercial</li>
            <li>Any useful photographs or timescales</li>
          </ul>
          <p class="contact-panel-note">We can add a direct enquiry form here once a submission method has been chosen.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
