---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const services = [
  {
    number: '01',
    title: 'Plastering & Skimming',
    description: 'Smooth, even finishes that create the perfect surface for decorating.',
    image: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=900&q=85',
    alt: 'Bright, carefully finished interior of a home'
  },
  {
    number: '02',
    title: 'Rendering',
    description: 'Quality external finishes to help give your property a fresh, smart appearance.',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=900&q=85',
    alt: 'Modern property exterior'
  },
  {
    number: '03',
    title: 'Dry Lining',
    description: 'Practical wall and ceiling preparation for new spaces and renovation projects.',
    image: 'https://images.unsplash.com/photo-1503387762-592d9b6b7c3a?auto=format&fit=crop&w=900&q=85',
    alt: 'Building and construction project'
  },
  {
    number: '04',
    title: 'Renovations & New Builds',
    description: 'Plastering work for property improvements, refurbishments and new projects.',
    image: 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=900&q=85',
    alt: 'Recently renovated interior'
  }
];
---

<Base
  title="Fenland Plastering Services | Quality Workmanship. Reliable Service."
  description="Fenland Plastering Services provides plastering solutions for domestic and commercial properties. Get in touch to discuss your project."
>
  <Header />

  <main>
    <section class="hero">
      <img
        class="hero-image"
        src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=90"
        alt="Beautifully finished contemporary home interior"
      />
      <div class="hero-shade"></div>

      <div class="hero-content">
        <span class="eyebrow hero-eyebrow">Domestic & Commercial Plastering</span>
        <h1>A quality finish.<br />A service you can rely on.</h1>
        <p>
          From small improvements to larger projects, we take pride in
          delivering professional plastering and a finish you can be proud of.
        </p>
        <div class="hero-actions">
          <a class="button button-gold" href={`${base}contact/`}>Request a Quote</a>
          <a class="hero-secondary-link" href={`${base}services/`}>Explore Our Services <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="hero-caption">
        <span>Fenland Plastering Services</span>
        <span>Quality Workmanship. Reliable Service.</span>
      </div>
    </section>

    <section class="intro-section section-padding">
      <div class="section-kicker">Welcome to Fenland Plastering Services</div>
      <div class="intro-grid">
        <div>
          <h2>Good work starts with<br />getting the details right.</h2>
        </div>
        <div class="intro-copy">
          <p>
            Whether you're improving a single room, renovating a property or
            working on a larger building project, the quality of the finish
            matters.
          </p>
          <p>
            Fenland Plastering Services is here to help with a professional,
            dependable approach and careful attention to the work being carried out.
          </p>
          <a class="text-link" href={`${base}about/`}>More about us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="services-section section-padding">
      <div class="section-heading">
        <div>
          <div class="section-kicker">What we do</div>
          <h2>Our Plastering Services</h2>
        </div>
        <p>
          Practical solutions and quality finishes for homes, businesses
          and building projects.
        </p>
      </div>

      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <a class="service-image-link" href={`${base}services/`} aria-label={`Learn about ${service.title}`}>
              <img src={service.image} alt={service.alt} loading="lazy" />
              <span class="service-number">{service.number}</span>
            </a>
            <div class="service-card-copy">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a class="text-link" href={`${base}services/`}>Discover more <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="services-bottom-link">
        <a class="button button-outline" href={`${base}services/`}>View All Services</a>
      </div>
    </section>

    <section class="promise-section">
      <div class="promise-inner">
        <div class="promise-mark" aria-hidden="true">✦</div>
        <div>
          <div class="section-kicker section-kicker-light">The Fenland approach</div>
          <h2>Work carried out with care.<br />Finishes made to last.</h2>
          <p>
            We believe a good job is about more than the finished surface.
            It's about clear communication, a professional approach and
            taking pride in the details.
          </p>
        </div>
        <a class="button button-light" href={`${base}contact/`}>Talk About Your Project</a>
      </div>
    </section>

    <section class="closing-section section-padding">
      <div class="closing-content">
        <div class="section-kicker">Let's get started</div>
        <h2>Have a project in mind?</h2>
        <p>
          Get in touch to discuss the work you need and find out how
          Fenland Plastering Services can help.
        </p>
        <a class="button button-dark" href={`${base}contact/`}>Contact Us</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
