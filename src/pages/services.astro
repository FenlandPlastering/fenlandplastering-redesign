---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const services = [
  {
    number: '01',
    title: 'Plastering & Skimming',
    description: 'A smooth, clean finish is the foundation of a beautifully presented room. Whether refreshing existing walls or finishing newly installed plasterboard, careful preparation and attention to detail make all the difference.',
    image: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1100&q=85',
    alt: 'Bright finished living room'
  },
  {
    number: '02',
    title: 'Rendering',
    description: 'External rendering can transform the appearance of a property. We can discuss suitable finishes for your building and the work required to achieve a neat, consistent result.',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=85',
    alt: 'Modern property exterior'
  },
  {
    number: '03',
    title: 'Dry Lining',
    description: 'Dry lining provides a practical way to prepare internal walls and ceilings. It is commonly used in new builds, extensions and refurbishment projects.',
    image: 'https://images.unsplash.com/photo-1503387762-592d9b6b7c3a?auto=format&fit=crop&w=1100&q=85',
    alt: 'Building construction project'
  },
  {
    number: '04',
    title: 'Renovations & New Builds',
    description: 'From individual rooms to larger property projects, plastering plays an important role in achieving a quality finish. We can discuss the requirements of your project and the work involved.',
    image: 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1100&q=85',
    alt: 'Renovated home interior'
  }
];
---

<Base title="Our Services | Fenland Plastering Services" description="Explore plastering, skimming, rendering, dry lining and property renovation services.">
  <Header />
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="eyebrow">What we do</span>
        <h1>Our Services</h1>
        <p>Professional plastering solutions, with care taken over every detail.</p>
      </div>
    </section>

    <section class="section-padding">
      <div class="page-intro">
        <span class="section-kicker">Domestic & Commercial</span>
        <h2>The right finish for your project.</h2>
        <p>Every property and project is different. We aim to understand what you need and provide a professional approach from preparation through to the finished surface.</p>
      </div>

      <div class="service-detail-list">
        {services.map((service) => (
          <article class="service-detail">
            <div class="service-detail-image">
              <img src={service.image} alt={service.alt} loading="lazy" />
            </div>
            <div class="service-detail-copy">
              <span class="section-kicker">Service {service.number}</span>
              <h2>{service.title}</h2>
              <p>{service.description}</p>
              <a class="text-link" href={`${base}contact/`}>Discuss this service <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="inner-cta">
      <span class="section-kicker section-kicker-light">Have a project in mind?</span>
      <h2>Let's talk about what you need.</h2>
      <p>Get in touch to discuss your requirements and ask about a quotation.</p>
      <a class="button button-light" href={`${base}contact/`}>Request a Quote</a>
    </section>
  </main>
  <Footer />
</Base>
