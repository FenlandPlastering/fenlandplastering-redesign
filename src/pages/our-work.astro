---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: 'Interior Finishes',
    category: 'Plastering',
    image: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85',
    alt: 'Finished interior living space'
  },
  {
    title: 'Property Improvements',
    category: 'Renovation',
    image: 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85',
    alt: 'Renovated interior'
  },
  {
    title: 'Modern Interiors',
    category: 'Finishing',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85',
    alt: 'Modern property interior'
  },
  {
    title: 'Building Projects',
    category: 'Construction',
    image: 'https://images.unsplash.com/photo-1503387762-592d9b6b7c3a?auto=format&fit=crop&w=1200&q=85',
    alt: 'Building project'
  },
  {
    title: 'Quality Living Spaces',
    category: 'Interior Work',
    image: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85',
    alt: 'Finished home interior'
  },
  {
    title: 'Property Finishes',
    category: 'Plastering',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85',
    alt: 'Contemporary finished property'
  }
];
---

<Base title="Our Work | Fenland Plastering Services" description="View examples of interiors and building projects to illustrate the type of work Fenland Plastering Services undertakes.">
  <Header />
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="eyebrow">A closer look</span>
        <h1>Our Work</h1>
        <p>Quality finishes and attention to detail.</p>
      </div>
    </section>

    <section class="section-padding">
      <div class="page-intro">
        <span class="section-kicker">Project Gallery</span>
        <h2>Work worth taking pride in.</h2>
        <p>Every project has its own requirements. This gallery is a place to showcase the standard of work and the finishes we deliver.</p>
      </div>

      <div class="work-grid">
        {projects.map((project, index) => (
          <article class:list={['work-card', index === 0 || index === 3 ? 'work-card-large' : '']}>
            <img src={project.image} alt={project.alt} loading="lazy" />
            <div class="work-card-overlay">
              <span>{project.category}</span>
              <h2>{project.title}</h2>
            </div>
          </article>
        ))}
      </div>
      <p class="gallery-note">The photographs shown are illustrative examples, not verified Fenland Plastering Services projects. Replace these with your own project photographs before presenting this as a portfolio.</p>
    </section>

    <section class="inner-cta">
      <span class="section-kicker section-kicker-light">Your project could be next</span>
      <h2>Let's discuss your plans.</h2>
      <p>Get in touch to tell us what you have in mind.</p>
      <a class="button button-light" href="../contact/">Contact Us</a>
    </section>
  </main>
  <Footer />
</Base>
