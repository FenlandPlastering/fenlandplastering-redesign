---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-name" href={base}>Fenland Plastering Services</a>
      <p class="footer-tagline">Quality Workmanship. Reliable Service.</p>
      <p>
        Professional plastering services for domestic and commercial
        properties, with care taken over every finish.
      </p>
    </div>

    <div class="footer-links">
      <h2>Explore</h2>
      <a href={base}>Home</a>
      <a href={`${base}services/`}>Our Services</a>
      <a href={`${base}about/`}>About Us</a>
      <a href={`${base}our-work/`}>Our Work</a>
      <a href={`${base}faqs/`}>FAQs</a>
      <a href={`${base}contact/`}>Contact</a>
    </div>

    <div class="footer-contact">
      <h2>Get in touch</h2>
      <p>Looking for a reliable plastering service?</p>
      <a class="footer-cta" href={`${base}contact/`}>Enquire about your project</a>
      <p class="footer-small">
        Add your confirmed telephone number, email address and service area
        to this section before publishing.
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Fenland Plastering Services</span>
    <span>Quality Workmanship. Reliable Service.</span>
  </div>
</footer>
